resource app_signature "application/x-vnd.idumych-PowerMix";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "PowerMix",
	long_info = "PowerMix 0.1.0, a 3D sound mixer in the spirit of BeOS 5's 3dmiX"
};

resource file_types message {
	"types" = "application/x-vnd.Be.3DSoundMixer_Master"
};
